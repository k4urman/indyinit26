{
  "name": "scamshield-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:all": "wxt build && wxt build -b firefox --mv3 && wxt build -b edge",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lists": "node scripts/build-lists.ts",
    "e2e": "node tests/e2e/smoke.mjs",
    "lint:firefox": "wxt build -b firefox --mv3 && npx -y web-ext lint -s .output/firefox-mv3 --self-hosted"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19"
  }
}
